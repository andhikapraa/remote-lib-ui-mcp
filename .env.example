# UI SSO credentials (same as sso.ui.ac.id login). REQUIRED.
REMOTE_LIB_USERNAME=your.sso.username
REMOTE_LIB_PASSWORD=your.sso.password

# OpenAlex API key — optional. The metadata backend (Scopus/JSTOR/Emerald/etc.)
# works keyless within a daily quota; set a key for a higher quota.
# REMOTE_LIB_OPENALEX_API_KEY=your_openalex_key

# --- Optional overrides (defaults shown) ---
# REMOTE_LIB_BASE_URL=https://remote-lib.ui.ac.id
# REMOTE_LIB_SSO_URL=https://sso.ui.ac.id
# REMOTE_LIB_HTTP_TIMEOUT=45
# REMOTE_LIB_HTTP_CONNECT_TIMEOUT=15
# REMOTE_LIB_HTTP2=true
# REMOTE_LIB_MAX_CONNECTIONS=20
# REMOTE_LIB_VERIFY_SSL=true
# REMOTE_LIB_LOG_LEVEL=INFO

# Switch specific databases OFF by default (comma-separated names or slugs).
# Disabled resources are hidden and error clearly if used; toggle at runtime
# with the set_resource_enabled tool.
# REMOTE_LIB_DISABLED=scopus,jstor

# Persist the EZproxy session across restarts (path to a JSON cookie file).
# Leave unset to keep the session in memory only.
# REMOTE_LIB_SESSION_FILE=~/.remote-lib-session.json

# Stealth-browser fallback (requires the `browser` extra: uv sync --extra browser)
# REMOTE_LIB_BROWSER_HEADLESS=true
# REMOTE_LIB_BROWSER_HUMANIZE=true
# REMOTE_LIB_BROWSER_WAIT_MS=3000
